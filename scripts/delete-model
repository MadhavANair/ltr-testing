#!/usr/bin/env bash
# Deletes a model from the local bot OpenSearch. Leaves the featureset in place.
# Usage: ./scripts/delete-model [Models/<model>.txt | <model name>]

set -e

cd "$(dirname "$0")/.."

model=${1:-$(ls -t Models/lambdamart_*.txt | head -1)}
name=$(basename "${model%.txt}")

echo "Deleting model $name..."
curl --fail-with-body -X DELETE "http://localhost:9201/_ltr/_model/$name"
